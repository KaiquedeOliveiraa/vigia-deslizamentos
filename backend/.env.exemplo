# Copie este arquivo para `.env` e preencha com os valores reais.
# O `.env` real nunca é versionado (veja .gitignore).

# Token do bot do Telegram, obtido com o @BotFather.
TELEGRAM_TOKEN=

# Token fine-grained do GitHub, com permissão só de "contents: write"
# neste repositório, usado para publicar o indices.json. No Actions vem do secret
# TOKEN_DADOS. Localmente use um valor falso: nenhuma execução local deve
# publicar na main.
GITHUB_TOKEN_DADOS=

# Repositório onde o indices.json é publicado, no formato dono/repo.
GITHUB_REPO=dono/repo

# URL pública do site, usada nas mensagens do bot.
SITE_URL=https://exemplo.org

# Caminho do arquivo do banco SQLite.
DB_PATH=./dados/vigia.db

# Caminho do arquivo de log do backend.
LOG_PATH=./dados/vigia.log

# OPCIONAL. Token da API do INMET, solicitado por e-mail a
# cadastro.act@inmet.gov.br (docs/decisoes/ensemble.md, seção 8). Sem ele, o
# sistema roda normalmente: só a comparação de conferência entre a chuva medida
# pela estação e a calculada deixa de ser registrada no log.
INMET_TOKEN=

# OPCIONAL, SÓ PARA DEMONSTRAÇÃO. Com "1", o bot ganha o comando /simular, que
# envia a mensagem de aviso de cada classe sem chuva real. Deixar vazio em
# produção; o comando será removido antes do deploy (docs/pendencias.md).
VIGIA_SIMULACAO=

# OPCIONAL. URL do Cloudflare Worker do bot, sem barra no fim (se vier, é
# removida). VIGIA_WORKER_URL e VIGIA_WORKER_SEGREDO andam juntas: definir só
# uma delas é erro de configuração. Vazia conta como ausente.
VIGIA_WORKER_URL=

# OPCIONAL. Segredo compartilhado com o Worker. Só vale junto com
# VIGIA_WORKER_URL (veja acima). Nunca aparece em log nem em mensagem de erro.
VIGIA_WORKER_SEGREDO=

# OPCIONAL. Caminho do arquivo bot.json (textos do bot usados pelo Worker).
# Vazio conta como ausente.
BOT_JSON_PATH=

# OPCIONAL, usado só pelo comando de setWebhook documentado no README (não é lido
# pelo backend). Mesmo valor do secret do Worker. Exemplo com valor falso:
# TELEGRAM_WEBHOOK_SEGREDO=troque-por-um-segredo-longo
