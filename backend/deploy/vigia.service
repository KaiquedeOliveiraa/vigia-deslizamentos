[Unit]
Description=VIGIA Deslizamentos — bot do Telegram e pipeline do índice de risco
Documentation=https://github.com/KaiquedeOliveiraa/vigia-deslizamentos
# O serviço só fala com APIs externas; sem rede ele sobe, falha a coleta e
# registra o erro — por isso `After`, e não `Requires`.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vigia
Group=vigia

WorkingDirectory=/opt/vigia/backend
# O `.env` guarda o token do bot e o do GitHub: permissão 600 e dono `vigia`.
#   sudo install -o vigia -g vigia -m 600 .env /etc/vigia/vigia.env
EnvironmentFile=/etc/vigia/vigia.env
ExecStart=/opt/vigia/backend/.venv/bin/python -m app.main

# Sem isto, o stdout do Python fica em buffer de bloco quando a saída é um pipe
# (que é o caso do journal): o `journalctl -u vigia -f` do README sairia
# atrasado e em blocos.
Environment=PYTHONUNBUFFERED=1

# Reinicia sempre: o processo é um long polling que deve viver indefinidamente.
# `RestartSec` evita laço apertado quando a falha é na subida.
Restart=always
RestartSec=10s

# Falha de configuração é permanente, e reiniciar não a conserta. Sem isto, um
# `.env` incompleto (saída 2) ou um token rejeitado pelo Telegram (saída 3)
# viram laço perpétuo de 10 s no journal. Com isto o systemd marca a unidade
# como `failed`, que é o estado honesto e o que um alerta operacional vê.
RestartPreventExitStatus=2 3

# Rede intermitente na subida pode reiniciar algumas vezes; depois disso o
# systemd desiste em vez de insistir para sempre.
StartLimitIntervalSec=300
StartLimitBurst=10

# `DB_PATH` e `LOG_PATH` do `.env` têm de apontar para dentro deste diretório,
# que é persistente e gravável pelo usuário do serviço. `StateDirectory` o cria
# com o dono e a permissão certos na primeira subida, sem `install -d` manual.
StateDirectory=vigia
ReadWritePaths=/var/lib/vigia

# O log do processo também vai para o journal, além do arquivo de LOG_PATH.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vigia

# Endurecimento: o serviço só precisa ler o código, escrever no banco e no log,
# e falar HTTPS.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# AF_UNIX junto de propósito: em hosts com `nss-resolve`, a resolução de DNS
# passa por um socket AF_UNIX, e sem ele o serviço depende do fallback para
# `nss-dns`. O filtro atinge `socket()`, não `socketpair()`, então o self-pipe
# do asyncio sobreviveria de todo modo — mas a resolução de nomes não.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
