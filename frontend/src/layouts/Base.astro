---
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/estrutura.css";
import geojson from "../data/municipios.geojson?raw";
import Cabecalho from "../components/Cabecalho";
import Menu from "../components/Menu";
import { atributoLang, idioma, tradutor } from "../i18n";
import { CHAVE } from "../lib/preferencias";
import { TELAS, rota } from "../lib/telas";

interface Props {
  /** Rota da tela ("" = Monitoramento). */
  tela: string;
}

const { tela } = Astro.props;
const lang = idioma(Astro.params.lang);
const t = tradutor(lang);
const nome = TELAS.find((x) => x.rota === tela)!.nome;
const outroLang = lang === "es" ? "pt" : "es";
// O script inline do <head> roda antes da pintura: idioma lembrado (vai para a outra versão da página),
// tema e paleta, com as mesmas regras de lerPreferencias/aplicarPreferencias (src/lib/preferencias.ts).

type Feicao = { properties: { nome: string; monitorado: boolean } };
const municipios = (JSON.parse(geojson).features as Feicao[])
  .filter((f) => f.properties.monitorado)
  .map((f) => f.properties.nome)
  .sort((a, b) => a.localeCompare(b, "pt-BR"));
---
<!doctype html>
<html lang={atributoLang(lang)} class="pal-geo">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t(`VIGIA · ${nome}`)}</title>
    <link rel="alternate" hreflang="pt-BR" href={rota(tela, "pt")} />
    <link rel="alternate" hreflang="es" href={rota(tela, "es")} />
    <script is:inline define:vars={{ chave: CHAVE, lang, outra: rota(tela, outroLang) }}>
      try {
        var p = JSON.parse(localStorage.getItem(chave) || "{}") || {};
        if ((p.lang === "pt" || p.lang === "es") && p.lang !== lang) location.replace(outra + location.search + location.hash);
        var d = document.documentElement;
        if (["light", "dark", "contraste"].indexOf(p.theme) >= 0) d.setAttribute("data-theme", p.theme);
        if (p.pal === "acc") d.classList.replace("pal-geo", "pal-acc");
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="app">
      <a class="skip" href="#conteudo">{t("Pular para o conteúdo")}</a>
      <Menu client:load lang={lang} tela={tela} />
      <Cabecalho client:load lang={lang} tela={tela} municipios={municipios} />
      <main id="conteudo" tabindex="-1">
        <slot />
      </main>
      <div id="anuncio" class="sr-only" role="status" aria-live="polite"></div>
    </div>
  </body>
</html>
