---
import Base from "../../layouts/Base.astro";
import Contatos from "../../components/Contatos";
import geojson from "../../data/municipios.geojson?raw";
import { caminhosIdioma, idioma } from "../../i18n";
import { municipiosMonitorados, type FeicaoMunicipio } from "../../lib/mapa";

export const getStaticPaths = caminhosIdioma;
const lang = idioma(Astro.params.lang);
const municipios = municipiosMonitorados(JSON.parse(geojson).features as FeicaoMunicipio[]);
---
<Base tela="contatos">
  <Contatos client:load lang={lang} municipios={municipios} />
</Base>
