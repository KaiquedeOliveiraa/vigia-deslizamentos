---
import Base from "../../layouts/Base.astro";
import Dados from "../../components/Dados";
import { caminhosIdioma, idioma } from "../../i18n";
import { MONITORADOS } from "../../lib/municipios";

export const getStaticPaths = caminhosIdioma;
const lang = idioma(Astro.params.lang);
const nomes = MONITORADOS;
---
<Base tela="dados">
  <Dados client:only="react" lang={lang} nomes={nomes} />
</Base>
