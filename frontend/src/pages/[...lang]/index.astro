---
import Base from "../../layouts/Base.astro";
import Monitoramento from "../../components/Monitoramento";
import { caminhosIdioma, idioma, tradutor } from "../../i18n";

export const getStaticPaths = caminhosIdioma;
const lang = idioma(Astro.params.lang);
const t = tradutor(lang);
---
<Base tela="">
  <h1 class="sr-only">{t("Monitoramento do risco de deslizamento")}</h1>
  <Monitoramento client:only="react" lang={lang} />
</Base>
