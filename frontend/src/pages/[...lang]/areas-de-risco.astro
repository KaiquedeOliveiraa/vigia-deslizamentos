---
import Base from "../../layouts/Base.astro";
import AreasRisco from "../../components/AreasRisco";
import { caminhosIdioma, idioma, tradutor } from "../../i18n";

export const getStaticPaths = caminhosIdioma;
const lang = idioma(Astro.params.lang);
const t = tradutor(lang);
---
<Base tela="areas-de-risco">
  <h1 class="sr-only">{t("Áreas de risco")}</h1>
  <AreasRisco client:only="react" lang={lang} />
</Base>
