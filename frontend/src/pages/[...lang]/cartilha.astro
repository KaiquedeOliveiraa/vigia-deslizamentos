---
import Base from "../../layouts/Base.astro";
import Cartilha from "../../components/Cartilha";
import { caminhosIdioma, idioma } from "../../i18n";
import { MONITORADOS } from "../../lib/municipios";

export const getStaticPaths = caminhosIdioma;
const lang = idioma(Astro.params.lang);
const municipios = MONITORADOS.map((m) => m.nome);
---
<Base tela="cartilha">
  <Cartilha client:load lang={lang} municipios={municipios} />
</Base>
