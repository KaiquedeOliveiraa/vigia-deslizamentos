{
  "name": "vigia-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vigia",
      "database_id": "<preencher na Tarefa 10>",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "BOT_JSON_URL": "https://raw.githubusercontent.com/KaiquedeOliveiraa/vigia-deslizamentos/estado/bot.json"
  }
}
