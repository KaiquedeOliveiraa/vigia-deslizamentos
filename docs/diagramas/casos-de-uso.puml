@startuml casos-de-uso
!pragma layout smetana
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #0B2A4A
}
skinparam actor {
  BorderColor #0B2A4A
}
skinparam rectangle {
  BorderColor #0B2A4A
}

actor "População" as POP
actor "Defesa Civil\nmunicipal" as DC
actor "Agendador" as AG

rectangle "VIGIA Deslizamentos" {
  usecase "UC01\nConsultar o risco\ndo município" as UC1
  usecase "UC02\nConsultar a previsão" as UC2
  usecase "UC03\nSimular uma chuva" as UC3
  usecase "UC04\nAssinar os alertas" as UC4
  usecase "UC05\nReceber aviso de alerta" as UC5
  usecase "UC06\nAtualizar os índices" as UC6
}

actor "Telegram" as TG

POP -- UC1
POP -- UC2
POP -- UC3
POP -- UC4
POP -- UC5
DC -- UC1
DC -- UC2
DC -- UC3
AG -- UC6

UC2 .> UC1 : <<extend>>
UC5 .> UC6 : <<extend>>

UC4 -- TG
UC5 -- TG
@enduml
